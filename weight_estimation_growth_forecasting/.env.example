# Weight Estimation & Growth Forecasting Service Environment Variables

# PostgreSQL Database Connection
DATABASE_URL=postgresql://hydroponic_user:your_secure_password@localhost:5432/hydroponic_iot

# JWT Configuration (must match auth service)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# Camera Calibration Parameters
FX=615.0
FY=615.0
DEPTH_SCALE=0.001

# Segmentation Model Parameters
SEG_THRESHOLD=0.5
USE_IMAGENET_NORM=false
