# Service
SERVICE_NAME=water-quality-ml-service
PORT=8006
CORS_ORIGINS=*

# Artifacts
WATER_MODEL_PATH=artifacts/water_status_model.joblib
ALGAE_MODEL_PATH=artifacts/algae_warning_model.joblib

# Feature settings
RESAMPLE_RULE=15min

# DB (optional but good)
DATABASE_URL=sqlite:///./app.db

# Single-mode history (if you want to allow /water/analyze without DB history)
HISTORY_MINUTES=90